{
  "name": "backseat",
  "version": "0.5.0",
  "private": true,
  "description": "AI 소통기 Backseat - point, talk, let the AI drive",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/render-logo.cjs --sheet=icon-sheet.png resources/logo.svg design/logo/render",
    "capture": "electron-vite build && electron . --capture",
    "selftest": "electron-vite build && electron . --selftest",
    "selftest-delivery": "electron-vite build && electron . --selftest-delivery",
    "test": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/support/register.mjs --test \"tests/**/*.test.ts\"",
    "mcp-check": "electron-vite build && node scripts/mcp-check.mjs",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/nanum-gothic": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "koffi": "^3.3.3",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.backseat.app",
    "productName": "Backseat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "out/main/mcp-server.js",
      "out/main/chunks/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Backseat",
      "license": "LICENSE"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon-1024.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Backseat records your voice while you mark up a capture, and turns it into text on this Mac."
      }
    },
    "dmg": {
      "sign": false,
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-1024.png",
      "category": "Development",
      "synopsis": "Mark up your screen, explain it out loud, and hand it to your AI coding tool",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
